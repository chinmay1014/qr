#!/bin/bash

mkdir -p "$HOME/qroot"
cd "$HOME/qroot" || exit 1

KERNEL_PATH="netboot.xyz.lkrn"
AVAILABLE_IMAGES=($(ls *.img *.iso *.qcow2 2>/dev/null))
BOOT_TARGET=""
DRIVE_FLAGS=""

if [ ${#AVAILABLE_IMAGES[@]} -gt 0 ]; then
    clear
        echo "================================================="
            echo "    DETECTED LOCAL IMAGES IN YOUR DIRECTORY      "
                echo "================================================="
                    echo " 0) Skip local files (Run netboot.xyz cloud loader)"
                        for i in "${!AVAILABLE_IMAGES[@]}"; do
                                echo " $((i+1))) ${AVAILABLE_IMAGES[$i]}"
                                    done
                                        echo " x) Exit program"
                                            echo "================================================="
                                                read -p "Select a disk image to boot [0-${#AVAILABLE_IMAGES[@]} or x]: " img_choice

                                                    if [ "$img_choice" = "x" ] || [ "$img_choice" = "X" ]; then
                                                            echo "Exiting."
                                                                    exit 0
                                                                        fi

                                                                            if [[ "$img_choice" =~ ^[0-9]+$ ]] && [ "$img_choice" -gt 0 ] && [ "$img_choice" -le "${#AVAILABLE_IMAGES[@]}" ]; then
                                                                                    SELECTED_FILE="${AVAILABLE_IMAGES[$((img_choice-1))]}"
                                                                                            echo "Configuring boot pipeline for: $SELECTED_FILE"
                                                                                                    if [[ "$SELECTED_FILE" == *.iso ]]; then
                                                                                                                DRIVE_FLAGS="-device virtio-blk-pci,drive=win_cd -drive file=$SELECTED_FILE,if=none,id=win_cd,media=cdrom -boot d"
                                                                                                                        else
                                                                                                                                    DRIVE_FLAGS="-device virtio-blk-pci,drive=win_hd -drive file=$SELECTED_FILE,if=none,id=win_hd,format=raw -boot c"
                                                                                                                                            fi
                                                                                                                                                    BOOT_TARGET="LOCAL"
                                                                                                                                                        fi
                                                                                                                                                        fi

                                                                                                                                                        if [ -z "$BOOT_TARGET" ]; then
                                                                                                                                                            if [ ! -s "$KERNEL_PATH" ]; then
                                                                                                                                                                    echo "Downloading netboot.xyz kernel straight to current directory..."
                                                                                                                                                                            curl -L -f -o "$KERNEL_PATH" "https://boot.netboot.xyz/ipxe/netboot.xyz.lkrn"
                                                                                                                                                                                    if [ ! -s "$KERNEL_PATH" ]; then
                                                                                                                                                                                                echo "[Error]: Download failed. Check internet access."
                                                                                                                                                                                                            rm -f "$KERNEL_PATH"
                                                                                                                                                                                                                        exit 1
                                                                                                                                                                                                                                fi
                                                                                                                                                                                                                                    fi
                                                                                                                                                                                                                                        STORAGE_DRIVE="installed_system.qcow2"
                                                                                                                                                                                                                                            if [ ! -f "$STORAGE_DRIVE" ]; then
                                                                                                                                                                                                                                                    echo "Creating virtual storage partition: $STORAGE_DRIVE"
                                                                                                                                                                                                                                                            qemu-img create -f qcow2 "$STORAGE_DRIVE" 64G
                                                                                                                                                                                                                                                                fi
                                                                                                                                                                                                                                                                    DRIVE_FLAGS="-kernel $KERNEL_PATH -hda $STORAGE_DRIVE"
                                                                                                                                                                                                                                                                    fi

                                                                                                                                                                                                                                                                    clear

                                                                                                                                                                                                                                                                    echo "================================================="
                                                                                                                                                                                                                                                                    echo "  PLZ SELECT ANY OF THOSE VEWING MEATHODS        "
                                                                                                                                                                                                                                                                    echo "================================================="
                                                                                                                                                                                                                                                                    echo " 1) noVNC   -> Opens directly in your Web Browser (Port 6080)"
                                                                                                                                                                                                                                                                    echo " 2) VNC     -> Access via any Android VNC Viewer App (Port 5901)"
                                                                                                                                                                                                                                                                    echo " 3) X11     -> Render inside a native window (Needs Termux-X11)"
                                                                                                                                                                                                                                                                    echo " 4) Curses  -> Force fallback text mode inside this terminal"
                                                                                                                                                                                                                                                                    echo " 5) Exit    -> Close and exit script"
                                                                                                                                                                                                                                                                    echo "================================================="
                                                                                                                                                                                                                                                                    read -p "Choose interface [1-5]: " display_choice

                                                                                                                                                                                                                                                                    QEMU_RUN="qemu-system-x86_64 \
                                                                                                                                                                                                                                                                        -machine pc \
                                                                                                                                                                                                                                                                            $DRIVE_FLAGS \
                                                                                                                                                                                                                                                                                -m 6144 \
                                                                                                                                                                                                                                                                                    -cpu max \
                                                                                                                                                                                                                                                                                        -accel tcg,thread=multi \
                                                                                                                                                                                                                                                                                            -smp cpus=4,cores=4,threads=1 \
                                                                                                                                                                                                                                                                                                -net nic,model=e1000 \
                                                                                                                                                                                                                                                                                                    -net user"

                                                                                                                                                                                                                                                                                                    case $display_choice in
                                                                                                                                                                                                                                                                                                        1)
                                                                                                                                                                                                                                                                                                                echo "Starting noVNC Server... Open http://localhost:6080/vnc.html"
                                                                                                                                                                                                                                                                                                                        novnc_proxy --vnc localhost:5901 --listen 6080 > /dev/null 2>&1 &
                                                                                                                                                                                                                                                                                                                                PROXY_PID=$!
                                                                                                                                                                                                                                                                                                                                        $QEMU_RUN -vnc :1
                                                                                                                                                                                                                                                                                                                                                kill $PROXY_PID 2>/dev/null
                                                                                                                                                                                                                                                                                                                                                        ;;
                                                                                                                                                                                                                                                                                                                                                            2)
                                                                                                                                                                                                                                                                                                                                                                    echo "Launching graphics console server on -> localhost:5901"
                                                                                                                                                                                                                                                                                                                                                                            $QEMU_RUN -vnc :1
                                                                                                                                                                                                                                                                                                                                                                                    ;;
                                                                                                                                                                                                                                                                                                                                                                                        3)
                                                                                                                                                                                                                                                                                                                                                                                                echo "Initializing native X11 execution window context..."
                                                                                                                                                                                                                                                                                                                                                                                                        $QEMU_RUN -display x11
                                                                                                                                                                                                                                                                                                                                                                                                                ;;
                                                                                                                                                                                                                                                                                                                                                                                                                    4)
                                                                                                                                                                                                                                                                                                                                                                                                                            echo "Starting standard terminal character map loop..."
                                                                                                                                                                                                                                                                                                                                                                                                                                    sleep 1
                                                                                                                                                                                                                                                                                                                                                                                                                                            $QEMU_RUN -display curses
                                                                                                                                                                                                                                                                                                                                                                                                                                                    ;;
                                                                                                                                                                                                                                                                                                                                                                                                                                                        5)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                echo "Exiting program context cleanly."
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        exit 0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ;;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    *)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            echo "Invalid parameters specified. Exiting process."
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    exit 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ;;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            esac
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            